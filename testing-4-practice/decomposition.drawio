<mxfile host="app.diagrams.net" type="device"><diagram name="Декомпозиция записи — БРИТВА" id="britva-decomposition"><mxGraphModel dx="1780" dy="2084" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="2084" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="root" value="БРИТВА — запись клиента" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1F2937;strokeColor=#111827;fontColor=#FFFFFF;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="240" height="60" as="geometry"/></mxCell><mxCell id="m0" value="M1. Каркас страницы" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="420" height="520" as="geometry"/></mxCell><mxCell id="e1000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#8A94A6;" edge="1" parent="1" source="root" target="m0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c0_2" value="&lt;b&gt;1.1 Шапка&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-01…04)&lt;/font&gt;&lt;br&gt;• Логотип → главная&lt;br&gt;• Меню: Услуги/Мастера/Отзывы/Контакты&lt;br&gt;• Телефон tel:&lt;br&gt;• Кнопка «Войти»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="70" width="388" height="114" as="geometry"/></mxCell><mxCell id="c0_3" value="&lt;b&gt;1.2 Возврат&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-05)&lt;/font&gt;&lt;br&gt;• Ссылка «К выбору услуги»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="196" width="388" height="54" as="geometry"/></mxCell><mxCell id="c0_4" value="&lt;b&gt;1.3 Заголовок&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-06)&lt;/font&gt;&lt;br&gt;• H1 + подзаголовок шага" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="262" width="388" height="54" as="geometry"/></mxCell><mxCell id="c0_5" value="&lt;b&gt;1.4 Подвал&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-07)&lt;/font&gt;&lt;br&gt;• Копирайт&lt;br&gt;• Политика конфиденциальности&lt;br&gt;• Правила записи" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="328" width="388" height="94" as="geometry"/></mxCell><mxCell id="c0_6" value="&lt;b&gt;1.5 Сетка&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-08)&lt;/font&gt;&lt;br&gt;• 2 колонки на десктопе&lt;br&gt;• 1 колонка на мобильном" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="434" width="388" height="74" as="geometry"/></mxCell><mxCell id="m1" value="M2. Индикатор шагов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="820" y="40" width="420" height="304" as="geometry"/></mxCell><mxCell id="e1001" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#8A94A6;" edge="1" parent="1" source="root" target="m1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c1_2" value="&lt;b&gt;2.1 Шаги&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-09)&lt;/font&gt;&lt;br&gt;• Услуга&lt;br&gt;• Дата и время&lt;br&gt;• Подтверждение" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="836" y="70" width="388" height="94" as="geometry"/></mxCell><mxCell id="c1_3" value="&lt;b&gt;2.2 Текущий&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-10)&lt;/font&gt;&lt;br&gt;• Выделение активного шага" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="836" y="176" width="388" height="54" as="geometry"/></mxCell><mxCell id="c1_4" value="&lt;b&gt;2.3 Пройденный&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-11)&lt;/font&gt;&lt;br&gt;• Отметка выполненного шага" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="836" y="242" width="388" height="54" as="geometry"/></mxCell><mxCell id="m2" value="M3. Календарь" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1300" y="40" width="420" height="668" as="geometry"/></mxCell><mxCell id="e1002" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#8A94A6;" edge="1" parent="1" source="root" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c2_2" value="&lt;b&gt;3.1 Заголовок&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-12)&lt;/font&gt;&lt;br&gt;• Месяц + год" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1316" y="70" width="388" height="54" as="geometry"/></mxCell><mxCell id="c2_3" value="&lt;b&gt;3.2 Навигация&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-19…21)&lt;/font&gt;&lt;br&gt;• «‹» назад&lt;br&gt;• «›» вперёд&lt;br&gt;• Переход через год" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1316" y="136" width="388" height="94" as="geometry"/></mxCell><mxCell id="c2_4" value="&lt;b&gt;3.3 Сетка дней&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-13…15)&lt;/font&gt;&lt;br&gt;• Дни недели Пн–Вс&lt;br&gt;• 7×6 = 42 ячейки&lt;br&gt;• Дни соседних месяцев" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1316" y="242" width="388" height="94" as="geometry"/></mxCell><mxCell id="c2_5" value="&lt;b&gt;3.4 Состояния дня&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-16…18)&lt;/font&gt;&lt;br&gt;• Прошедший: disabled&lt;br&gt;• Сегодня: пунктир&lt;br&gt;• Выбранный: заливка&lt;br&gt;• Hover" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1316" y="348" width="388" height="114" as="geometry"/></mxCell><mxCell id="c2_6" value="&lt;b&gt;3.5 Легенда&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-23)&lt;/font&gt;&lt;br&gt;• Выбранный день&lt;br&gt;• Сегодня" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1316" y="474" width="388" height="74" as="geometry"/></mxCell><mxCell id="c2_7" value="&lt;b&gt;3.6 Выбор дня&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-22, 24, 25)&lt;/font&gt;&lt;br&gt;• Клик по доступному&lt;br&gt;• Игнор прошедшего&lt;br&gt;• Нормализация при листании" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1316" y="560" width="388" height="94" as="geometry"/></mxCell><mxCell id="m3" value="M4. Слоты времени" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="340" y="600" width="420" height="804" as="geometry"/></mxCell><mxCell id="e1003" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#8A94A6;" edge="1" parent="1" source="root" target="m3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c3_2" value="&lt;b&gt;4.1 Заголовок&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-26)&lt;/font&gt;&lt;br&gt;• «Свободное время»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="630" width="388" height="54" as="geometry"/></mxCell><mxCell id="c3_3" value="&lt;b&gt;4.2 Дата&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-27)&lt;/font&gt;&lt;br&gt;• Дата выбранного дня" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="696" width="388" height="54" as="geometry"/></mxCell><mxCell id="c3_4" value="&lt;b&gt;4.3 Бейдж&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-28)&lt;/font&gt;&lt;br&gt;• Число свободных слотов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="762" width="388" height="54" as="geometry"/></mxCell><mxCell id="c3_5" value="&lt;b&gt;4.4 Группы&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-29)&lt;/font&gt;&lt;br&gt;• Утро&lt;br&gt;• День&lt;br&gt;• Вечер" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="828" width="388" height="94" as="geometry"/></mxCell><mxCell id="c3_6" value="&lt;b&gt;4.5 Слот&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-30, 31)&lt;/font&gt;&lt;br&gt;• Свободный&lt;br&gt;• Занятый: disabled&lt;br&gt;• Выбранный" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="934" width="388" height="94" as="geometry"/></mxCell><mxCell id="c3_7" value="&lt;b&gt;4.6 Взаимодействие&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-32, 33)&lt;/font&gt;&lt;br&gt;• Клик — выбрать&lt;br&gt;• Повторный — снять&lt;br&gt;• Смена дня — сброс" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="1040" width="388" height="94" as="geometry"/></mxCell><mxCell id="c3_8" value="&lt;b&gt;4.7 Заметка&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-34)&lt;/font&gt;&lt;br&gt;• Длительность визита&lt;br&gt;• Мастер" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="1146" width="388" height="74" as="geometry"/></mxCell><mxCell id="c3_9" value="&lt;b&gt;4.8 Состояния&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-35…38)&lt;/font&gt;&lt;br&gt;• Загрузка слотов&lt;br&gt;• Ошибка + «Повторить»&lt;br&gt;• Пусто: «Нет времени»&lt;br&gt;• Гонка ответов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="356" y="1232" width="388" height="114" as="geometry"/></mxCell><mxCell id="m4" value="M5. Панель итога" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="820" y="384" width="420" height="440" as="geometry"/></mxCell><mxCell id="e1004" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#8A94A6;" edge="1" parent="1" source="root" target="m4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c4_2" value="&lt;b&gt;5.1 Дата&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-39)&lt;/font&gt;&lt;br&gt;• Выбранная дата" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="836" y="414" width="388" height="54" as="geometry"/></mxCell><mxCell id="c4_3" value="&lt;b&gt;5.2 Время&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-40)&lt;/font&gt;&lt;br&gt;• Выбранное время" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="836" y="480" width="388" height="54" as="geometry"/></mxCell><mxCell id="c4_4" value="&lt;b&gt;5.3 Пусто&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-41)&lt;/font&gt;&lt;br&gt;• «время не выбрано»" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="836" y="546" width="388" height="54" as="geometry"/></mxCell><mxCell id="c4_5" value="&lt;b&gt;5.4 Кнопка «Далее»&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-42…44)&lt;/font&gt;&lt;br&gt;• Отображение&lt;br&gt;• disabled до выбора&lt;br&gt;• Обработчик перехода" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="836" y="612" width="388" height="94" as="geometry"/></mxCell><mxCell id="c4_6" value="&lt;b&gt;5.5 Сумма&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-45)&lt;/font&gt;&lt;br&gt;• К оплате" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="836" y="718" width="388" height="54" as="geometry"/></mxCell><mxCell id="m5" value="M6. Доступность и вёрстка" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#6366F1;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1300" y="748" width="420" height="460" as="geometry"/></mxCell><mxCell id="e1005" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeColor=#8A94A6;" edge="1" parent="1" source="root" target="m5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c5_2" value="&lt;b&gt;6.1 Семантика&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-46, 47)&lt;/font&gt;&lt;br&gt;• header/nav/main/section/aside/footer&lt;br&gt;• ARIA-имена" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1316" y="778" width="388" height="74" as="geometry"/></mxCell><mxCell id="c5_3" value="&lt;b&gt;6.2 Клавиатура&lt;/b&gt;  &lt;font color=&#x27;#6B7280&#x27;&gt;(REQ-48)&lt;/font&gt;&lt;br&gt;• Tab / стрелки / Enter&lt;br&gt;• :focus-visible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A5B4FC;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1316" y="864" width="388" height="74" as="geometry"/></mxCell><mxCell id="c5